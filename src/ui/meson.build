    'persona/stroke_panel.cpp',
    'persona/appearance_panel.cpp',
    'panels/shared/panel_helpers.cpp',
    'panels/layers/layers_panel.cpp',
    'panels/channels/channels_panel.cpp',
    'panels/paths/paths_panel.cpp',
    'panels/adjustments/adjustments_panel.cpp',
    'panels/properties/properties_panel.cpp',
    'panels/color/color_panel.cpp',
    'panels/swatches/swatches_panel.cpp',
    'panels/history/history_panel.cpp',
    'panels/info/info_panel.cpp',
    'panels/navigator/navigator_panel.cpp',
