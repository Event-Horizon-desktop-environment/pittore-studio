    'canvas/interactions/canvas_mouse_move.cpp',
    'canvas/interactions/canvas_mouse_release.cpp',
    'canvas/interactions/canvas_hover.cpp',
    'canvas/pen/canvas_pen.cpp',
    'canvas/pen/canvas_vector_tools.cpp',
    'canvas/move/canvas_move.cpp',
    'canvas/ai/canvas_ai_select.cpp',
    'contextual_task_bar.cpp',
    'curve_editor.cpp',
    'export/shared/export_helpers.cpp',
    'export/shell/export_shell.cpp',
    'export/settings/export_settings.cpp',
    'export/io/export_writers.cpp',
    'filter_dialog.cpp',
