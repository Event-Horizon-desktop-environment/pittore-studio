    'panels/paragraph/paragraph_panel.cpp',
    'panels/actions/actions_panel.cpp',
    'panels/libraries/libraries_panel.cpp',
    'panels/aimodels/aimodels_panel.cpp',
    'panels/vector/vector_panels.cpp',
    'panels/registry/panels_registry.cpp',
    'export/presets/export_presets.cpp',
    'preferences_dialog.cpp',
    'project_manager.cpp',
    'refine_dialog.cpp',
    'mask_finish.cpp',
    'live_filter.cpp',
    'selection_ops.cpp',
    'psd_export.cpp',
    'af_export.cpp',
    'selection_mask.cpp',
    'color_mode.cpp',
    'settings.cpp',
    'spotlight.cpp',
    'svg_parts.cpp',
    'svg_import_task.cpp',
    'svg_bridge.cpp',
    'theme.cpp',
    'tone_dialogs.cpp',
    'tone_blend_dialog.cpp',
    'color_grade_dialog.cpp',
    'color_mismatch.cpp',
    'font_preview.cpp',
    'proof_preview.cpp',
    'tools/table/tool_table.cpp',
    'tools/table/tool_lookup.cpp',
    'tools/log/tool_log.cpp',
    'tools/options/option_builders.cpp',
    'tools/options/options_selection.cpp',
    'tools/options/options_crop.cpp',
    'tools/options/options_retouch.cpp',
    'tools/options/options_draw.cpp',
    'tools/options/options_navgen.cpp',
    'tools/options/options_registry.cpp',
    'mcp/mcp_bridge.cpp',
    'tools_panel.cpp',
    'workspace.cpp',
  )

  moc = qt6.preprocess(
    moc_headers : ui_moc_headers,
    qresources : files('icons.qrc'),
    include_directories : src_inc)

  pittore_ui = static_library('pittore-ui',
    moc,
    ui_sources,
    include_directories : src_inc,
    cpp_args : qrencode_dep.found() ? ['-DHAVE_QRENCODE'] : [],
    dependencies : [qt6dep, qt6net, qt6svg, pittore_compute_dep, pittore_ai_dep,
                    pittore_io_dep, pittore_render_dep, pittore_color_dep, tomlplusplus, qrencode_dep, lcms2],
    install : false)

  pittore_ui_dep = declare_dependency(
    link_with : pittore_ui,
    include_directories : src_inc,
    dependencies : [qt6dep, qt6net, qt6svg, pittore_compute_dep, pittore_ai_dep,
                    pittore_io_dep, pittore_render_dep, pittore_color_dep, tomlplusplus, qrencode_dep, lcms2])
endif
