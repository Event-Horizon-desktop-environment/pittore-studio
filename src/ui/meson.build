    'keymap.cpp',
    'layer_style_dialog.cpp',
    'liquify_dialog.cpp',
    'logging.cpp',
    'window/shared/window_helpers.cpp',
    'window/shell/window_shell.cpp',
    'window/shell/document_area.cpp',
    'window/shell/window_session.cpp',
    'window/docks/window_docks.cpp',
    'window/menus/menu_actions.cpp',
    'window/menus/menu_bar.cpp',
    'window/menus/menu_file.cpp',
    'window/menus/menu_edit.cpp',
    'window/menus/ops/menu_ops_edit.cpp',
    'window/menus/menu_image.cpp',
    'window/menus/menu_layer.cpp',
    'window/menus/menu_type.cpp',
    'window/menus/menu_select.cpp',
    'window/menus/menu_filter.cpp',
    'window/menus/menu_view.cpp',
    'window/menus/menu_object.cpp',
    'window/menus/menu_path.cpp',
    'window/menus/menu_plugins.cpp',
    'window/menus/menu_window.cpp',
    'window/menus/menu_help.cpp',
    'window/state/window_state.cpp',
    'window/state/window_shortcuts.cpp',
    'window/commands/window_commands.cpp',
    'window/commands/window_ai.cpp',
    'window/dialogs/dialogs_file.cpp',
    'window/dialogs/dialogs_ui.cpp',
    'window/dialogs/dialogs_filter.cpp',
    'window/dialogs/dialogs_liquify.cpp',
