# src/ui/meson.build
# Qt6 Widgets UX layer. Only built when Qt6 is found (-Dapp, default auto).
#
# The UI is Qt-only: engine headers are used only for data types and the IO
# codecs (engine/core/image.h, engine/io/*.h) so the rendering core stays free
# of any toolkit dependency.

qt6 = import('qt6')
qt6dep = dependency('Qt6Widgets', required : get_option('app'))
qt6net = dependency('Qt6Network', required : get_option('app'))
qt6svg = dependency('Qt6Svg', required : get_option('app'))
lcms2 = dependency('lcms2', required : get_option('app'))
has_qt6 = qt6dep.found()

# QR encoder for the vector QR Code tool: optional — without it the tool
# keeps its honest refusal and everything else builds unchanged.
qrencode_dep = dependency('libqrencode', required : false)

tomlplusplus = dependency('tomlplusplus',
                          required : get_option('app'))

if has_qt6
  ui_moc_headers = files(
    'ai_models.h',
    'app_state.h',
    'canvas_view.h',
    'contextual_task_bar.h',
    'export_dialog.h',
    'filter_dialog.h',
    'layer_style_dialog.h',
    'liquify_dialog.h',
    'main_window.h',
    'mcp/mcp_bridge.h',
    'options_bar.h',
    'persona/persona_bar.h',
    'persona/persona_manager.h',
    'persona/stroke_panel.h',
    'persona/appearance_panel.h',
    'font_preview.h',
    'preferences_dialog.h',
    'project_manager.h',
    'refine_dialog.h',
    'spotlight.h',
    'tone_dialogs.h',
    'tone_blend_dialog.h',
    'color_grade_dialog.h',
    'tools_panel.h',
    'workspace.h',
  )

  ui_sources = files(
    'ai_models.cpp',
    'app_state.cpp',
    'app_state_detail.cpp',
    'app_state_open.cpp',
    'app_state_save.cpp',
    'app_state_text.cpp',
    'app_state_layers.cpp',
    'app_state_mask.cpp',
    'app_state_adjust.cpp',
    'app_state_stroke.cpp',
    'app_state_stamp.cpp',
    'app_state_smudge.cpp',
    'app_state_selection.cpp',
    'app_state_undo.cpp',
    'composite_gpu.cpp',
    'canvas/shared/canvas_helpers.cpp',
    'canvas/shell/canvas_shell.cpp',
    'canvas/shell/canvas_events.cpp',
    'canvas/view/canvas_zoom.cpp',
    'canvas/view/canvas_rulers.cpp',
    'canvas/paint/canvas_document.cpp',
    'canvas/paint/canvas_display_mode.cpp',
    'canvas/paint/canvas_crisp.cpp',
    'canvas/paint/canvas_layer_cache.cpp',
    'canvas/paint/canvas_tile_store.cpp',
    'canvas/paint/canvas_overlay.cpp',
    'canvas/paint/canvas_annotations.cpp',
    'canvas/paint/canvas_brush.cpp',
    'canvas/paint/canvas_liquify.cpp',
    'canvas/text/canvas_text.cpp',
