# Maintainer: Pittore Studio
pkgname=pittore-studio
pkgver=0.1.1
pkgrel=1
pkgdesc='Layer-based photo editor for Linux'
arch=('x86_64')
url='https://github.com/arrifat346afs/pittore-studio'
license=('MIT')
# No LTO: makepkg's default -flto makes BFD ld fail the final link with
# "copy relocation against non-copyable protected symbol" on Qt6's
# staticMetaObject symbols.
options=('!lto')
depends=('qt6-base' 'qt6-svg' 'zlib' 'harfbuzz' 'freetype2' 'fontconfig' 'lcms2'
         'libwebp' 'libtiff' 'libjpeg-turbo' 'zstd' 'qrencode' 'tomlplusplus')
optdepends=('hip-runtime-amd: AMD GPU compute backend (ROCm HIP runtime)')
makedepends=('meson' 'ninja' 'git' 'pkgconf' 'hip-runtime-amd')
source=("$pkgname-$pkgver.tar.gz::https://github.com/arrifat346afs/pittore-studio/archive/refs/tags/v$pkgver.tar.gz")
sha256sums=('SKIP')

build() {
  meson setup build "$srcdir/$pkgname-$pkgver" --prefix=/usr -Dbuildtype=release \
    -Dbackend-cuda=enabled -Dcuda-archs=sm_75,sm_80,sm_86,sm_89,sm_90,sm_100,sm_120,+ptx \
    -Dbackend-hip=enabled -Dhip-archs=gfx906,gfx908,gfx90a,gfx942,gfx950,gfx1010,gfx1012,gfx1030,gfx1031,gfx1032,gfx1100,gfx1101,gfx1102,gfx1103,gfx1150,gfx1151,gfx1200,gfx1201 \
    -Donnxruntime=disabled -Dapp=enabled
  ninja -C build src/app/painter src/app/pittore-mcp src/engine/compute/libpittore-hip.so
}

package() {
  DESTDIR="$pkgdir" meson install -C build --no-rebuild
}
